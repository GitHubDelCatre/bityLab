@page
@model GarantiasModel
@{
    ViewData["Title"] = Model.Titulo;
}
<form method="post" enctype="multipart/form-data">
    <h1 class="text-center">Garantías</h1>

    <div class="d-flex flex-wrap gap-2 justify-content-center my-3">
        <input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
        <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" />
        <input asp-for="@Model.Filtro!.MotivoFalla" class="form-control w-auto" placeholder="Buscar" />
        <input type="submit" value="PDF" class="btn btn-outline-secondary" asp-page-handler="BtPdf" />
        <input type="submit" value="Excel" class="btn btn-outline-secondary" asp-page-handler="BtExcel" />
    </div>

    @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml")

    @if (Model.Formulario || Model.Borrar)
    {
        <input type="hidden" asp-for="@Model.Actual!.Id" />
    }

    @if (Model.Formulario)
    {
        <div class="card mt-3">
            <div class="card-header">@(Model.Actual!.Id == 0 ? "Nuevo registro" : "Editar registro " + Model.Actual!.Id)</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">Producto vendido *</label>
                    <select asp-for="@Model.Actual!.DetalleVenta" class="form-select"
                            asp-items="@(new SelectList(Model.ListaDetallesVentas, "Id", null))">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha de solicitud *</label>
                    <input type="date" asp-for="@Model.Actual!.FechaSolicitud" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Falla reportada *</label>
                    <input asp-for="@Model.Actual!.MotivoFalla" class="form-control" maxlength="200" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Estado *</label>
                    <select asp-for="@Model.Actual!.EstadoGarantia" class="form-select">
                        <option value="">-- Seleccione --</option>
                        <option value="Recibida">Recibida</option>
                        <option value="En diagnóstico">En diagnóstico</option>
                        <option value="Reparada">Reparada</option>
                        <option value="Reemplazada">Reemplazada</option>
                        <option value="Rechazada">Rechazada</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Resolución técnica</label>
                    <input asp-for="@Model.Actual!.ResolucionTecnica" class="form-control" maxlength="200" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha de cierre</label>
                    <input type="date" asp-for="@Model.Actual!.FechaCierre" class="form-control" />
                </div>
            </div>
            <div class="card-footer">
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" />
                <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
            </div>
        </div>
    }

    @if (Model.Borrar)
    {
        <div class="alert alert-warning mt-3">
            ¿Quiere borrar <b>@Model.Actual</b>?
            <input type="submit" value="Borrar" class="btn btn-danger btn-sm ms-2" asp-page-handler="BtBorrar" />
            <input type="submit" value="Cancelar" class="btn btn-secondary btn-sm" asp-page-handler="BtConsultar" />
        </div>
    }

    @if (!Model.Formulario)
    {
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                    <th>Id</th>
                    <th>Producto vendido</th>
                    <th>Fecha de solicitud</th>
                    <th>Falla reportada</th>
                    <th>Estado</th>
                    <th>Resolución técnica</th>
                    <th>Fecha de cierre</th>
                    <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                        <td>@elemento.Id</td>
                        <td>@elemento._DetalleVenta</td>
                        <td>@elemento.FechaSolicitud?.ToString("yyyy-MM-dd")</td>
                        <td>@elemento.MotivoFalla</td>
                        <td>@elemento.EstadoGarantia</td>
                        <td>@elemento.ResolucionTecnica</td>
                        <td>@elemento.FechaCierre?.ToString("yyyy-MM-dd")</td>
                        <td>
                            <input type="submit" value="Editar" class="btn btn-secondary btn-sm" asp-page-handler="BtEditar" asp-route-data="@elemento.Id" />
                            <input type="submit" value="Borrar" class="btn btn-danger btn-sm" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id" />
                        </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</form>
