@page
@model ProductosModel
@{
    ViewData["Title"] = Model.Titulo;
}
<form method="post" enctype="multipart/form-data">
    <h1 class="text-center">Productos</h1>

    <div class="d-flex flex-wrap gap-2 justify-content-center my-3">
        <input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
        <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" />
        <input asp-for="@Model.Filtro!.NombreProducto" class="form-control w-auto" placeholder="Buscar" />
        <input type="submit" value="PDF" class="btn btn-outline-secondary" asp-page-handler="BtPdf" />
        <input type="submit" value="Excel" class="btn btn-outline-secondary" asp-page-handler="BtExcel" />
    </div>

    @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml")

    @if (Model.Formulario || Model.Borrar)
    {
        <input type="hidden" asp-for="@Model.Actual!.Id" />
    }

    @if (Model.Formulario)
    {
        <div class="card mt-3">
            <div class="card-header">@(Model.Actual!.Id == 0 ? "Nuevo registro" : "Editar registro " + Model.Actual!.Id)</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">Categoría *</label>
                    <select asp-for="@Model.Actual!.Categoria" class="form-select"
                            asp-items="@(new SelectList(Model.ListaCategorias, "Id", null))">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Marca *</label>
                    <select asp-for="@Model.Actual!.Marca" class="form-select"
                            asp-items="@(new SelectList(Model.ListaMarcas, "Id", null))">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Producto *</label>
                    <input asp-for="@Model.Actual!.NombreProducto" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Descripción</label>
                    <textarea asp-for="@Model.Actual!.DescripcionLarga" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Precio de venta *</label>
                    <input type="number" step="0.01" asp-for="@Model.Actual!.PrecioVenta" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Número de serie</label>
                    <input asp-for="@Model.Actual!.NumeroSerie" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Modelo</label>
                    <input asp-for="@Model.Actual!.Modelo" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Especificaciones técnicas (JSON)</label>
                    <textarea asp-for="@Model.Actual!.EspecificacionesTecnicas" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Imagen</label>
                    <input type="file" asp-for="FormFile" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.Actual!.Imagen))
                    {
                        <img src="data:image;base64,@Model.Actual!.Imagen" class="mt-2" width="80" height="80" alt="" />
                    }
                </div>
            </div>
            <div class="card-footer">
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" />
                <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
            </div>
        </div>
    }

    @if (Model.Borrar)
    {
        <div class="alert alert-warning mt-3">
            ¿Quiere borrar <b>@Model.Actual</b>?
            <input type="submit" value="Borrar" class="btn btn-danger btn-sm ms-2" asp-page-handler="BtBorrar" />
            <input type="submit" value="Cancelar" class="btn btn-secondary btn-sm" asp-page-handler="BtConsultar" />
        </div>
    }

    @if (!Model.Formulario)
    {
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                    <th>Id</th>
                    <th>Categoría</th>
                    <th>Marca</th>
                    <th>Producto</th>
                    <th>Precio de venta</th>
                    <th>Número de serie</th>
                    <th>Modelo</th>
                    <th>Imagen</th>
                    <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                        <td>@elemento.Id</td>
                        <td>@elemento._Categoria</td>
                        <td>@elemento._Marca</td>
                        <td>@elemento.NombreProducto</td>
                        <td>@elemento.PrecioVenta?.ToString("N2")</td>
                        <td>@elemento.NumeroSerie</td>
                        <td>@elemento.Modelo</td>
                        <td>@if (!string.IsNullOrEmpty(elemento.Imagen)) { <img src="data:image;base64,@elemento.Imagen" width="48" height="48" alt="" /> }</td>
                        <td>
                            <input type="submit" value="Editar" class="btn btn-secondary btn-sm" asp-page-handler="BtEditar" asp-route-data="@elemento.Id" />
                            <input type="submit" value="Borrar" class="btn btn-danger btn-sm" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id" />
                        </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</form>
