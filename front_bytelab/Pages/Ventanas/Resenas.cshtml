@page
@model ResenasModel
@{
    ViewData["Title"] = Model.Titulo;
}
<form method="post">
    <h1 class="text-center">Reseñas</h1>

    @if (Model.EsCliente && Model.MiCliente != null)
    {
        <p class="text-center text-muted">Sus reseñas se publican como <b>@Model.MiCliente</b></p>
    }

    <div class="d-flex flex-wrap gap-2 justify-content-center my-3">
        <input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
        <input type="submit" value="Nueva reseña" class="btn btn-secondary" asp-page-handler="BtNuevo" />
        <input asp-for="@Model.Filtro!._Producto!.NombreProducto" class="form-control w-auto" placeholder="Buscar producto" />
        <input type="submit" value="PDF" class="btn btn-outline-secondary" asp-page-handler="BtPdf" />
        <input type="submit" value="Excel" class="btn btn-outline-secondary" asp-page-handler="BtExcel" />
    </div>

    @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml")

    @if (Model.Formulario || Model.Borrar)
    {
        <input type="hidden" asp-for="@Model.Actual!.Id" />
    }

    @if (Model.Formulario)
    {
        <div class="card mt-3">
            <div class="card-header">@(Model.Actual!.Id == 0 ? "Nueva reseña" : "Editar reseña " + Model.Actual!.Id)</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">Producto *</label>
                    <select asp-for="@Model.Actual!.Producto" class="form-select"
                            asp-items="@(new SelectList(Model.ListaProductos, "Id", null))">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Cliente *</label>
                    @if (Model.EsCliente)
                    {
                        @* El cliente no elige: se toma del usuario que inició sesión *@
                        <input type="hidden" asp-for="@Model.Actual!.Cliente" />
                        <input class="form-control" readonly value="@Model.MiCliente" />
                    }
                    else
                    {
                        <select asp-for="@Model.Actual!.Cliente" class="form-select"
                                asp-items="@(new SelectList(Model.ListaClientes, "Id", null))">
                            <option value="0">-- Seleccione --</option>
                        </select>
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">Calificación *</label>
                    <select asp-for="@Model.Actual!.CalificacionEstrellas" class="form-select estrellas">
                        <option value="5">★★★★★ (5)</option>
                        <option value="4">★★★★ (4)</option>
                        <option value="3">★★★ (3)</option>
                        <option value="2">★★ (2)</option>
                        <option value="1">★ (1)</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de publicación</label>
                    @if (Model.EsCliente)
                    {
                        <input type="hidden" asp-for="@Model.Actual!.FechaPublicacion" />
                        <input class="form-control" readonly value="@(Model.Actual!.FechaPublicacion?.ToString("yyyy-MM-dd HH:mm"))" />
                    }
                    else
                    {
                        <input type="datetime-local" asp-for="@Model.Actual!.FechaPublicacion" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    }
                </div>

                <div class="col-12">
                    <label class="form-label">Comentario</label>
                    <textarea asp-for="@Model.Actual!.Comentario" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="card-footer">
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" />
                <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
            </div>
        </div>
    }

    @if (Model.Borrar)
    {
        <div class="alert alert-warning mt-3">
            ¿Quiere borrar la reseña <b>@Model.Actual</b>?
            <input type="submit" value="Borrar" class="btn btn-danger btn-sm ms-2" asp-page-handler="BtBorrar" />
            <input type="submit" value="Cancelar" class="btn btn-secondary btn-sm" asp-page-handler="BtConsultar" />
        </div>
    }

    @if (!Model.Formulario)
    {
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Producto</th>
                        <th>Cliente</th>
                        <th>Calificación</th>
                        <th>Comentario</th>
                        <th>Fecha</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var elemento in Model.Lista)
                    {
                        var estrellas = Math.Clamp(elemento.CalificacionEstrellas ?? 0, 0, 5);
                        <tr>
                            <td>@elemento.Id</td>
                            <td>@elemento._Producto</td>
                            <td>
                                @elemento._Cliente
                                @if (Model.EsMia(elemento))
                                {
                                    <span class="badge bg-primary ms-1">Mía</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                <span class="estrellas">@(new string('★', estrellas))</span><span class="text-muted">@(new string('☆', 5 - estrellas))</span>
                            </td>
                            <td>@elemento.Comentario</td>
                            <td>@elemento.FechaPublicacion?.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (!Model.EsCliente)
                                {
                                    <input type="submit" value="Editar" class="btn btn-secondary btn-sm" asp-page-handler="BtEditar" asp-route-data="@elemento.Id" />
                                    <input type="submit" value="Borrar" class="btn btn-danger btn-sm" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id" />
                                }
                                else if (Model.EsMia(elemento))
                                {
                                    <input type="submit" value="Borrar" class="btn btn-danger btn-sm" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</form>
