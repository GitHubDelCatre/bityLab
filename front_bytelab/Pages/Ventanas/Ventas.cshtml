@page
@model VentasModel
@{
    ViewData["Title"] = Model.Titulo;
}
<form method="post" enctype="multipart/form-data">
    <h1 class="text-center">Ventas</h1>

    <div class="d-flex flex-wrap gap-2 justify-content-center my-3">
        <input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
        <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" />
        <input asp-for="@Model.Filtro!._Cliente!._Usuario!.NombreCompleto" class="form-control w-auto" placeholder="Buscar" />
        <input type="submit" value="PDF" class="btn btn-outline-secondary" asp-page-handler="BtPdf" />
        <input type="submit" value="Excel" class="btn btn-outline-secondary" asp-page-handler="BtExcel" />
    </div>

    @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml")

    @if (Model.Formulario || Model.Borrar)
    {
        <input type="hidden" asp-for="@Model.Actual!.Id" />
    }

    @if (Model.Formulario)
    {
        <div class="card mt-3">
            <div class="card-header">@(Model.Actual!.Id == 0 ? "Nuevo registro" : "Editar registro " + Model.Actual!.Id)</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">Cliente *</label>
                    <select asp-for="@Model.Actual!.Cliente" class="form-select"
                            asp-items="@(new SelectList(Model.ListaClientes, "Id", null))">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Sucursal *</label>
                    <select asp-for="@Model.Actual!.Sucursal" class="form-select"
                            asp-items="@(new SelectList(Model.ListaSucursales, "Id", null))">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Promoción</label>
                    <select asp-for="@Model.Actual!.Promocion" class="form-select"
                            asp-items="@(new SelectList(Model.ListaPromociones, "Id", null))">
                        <option value="">-- Ninguna --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha *</label>
                    <input type="datetime-local" asp-for="@Model.Actual!.FechaVenta" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Estado *</label>
                    <select asp-for="@Model.Actual!.EstadoVenta" class="form-select">
                        <option value="">-- Seleccione --</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Pagada">Pagada</option>
                        <option value="Enviada">Enviada</option>
                        <option value="Entregada">Entregada</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Total a pagar (automático)</label>
                    <input type="hidden" asp-for="@Model.Actual!.TotalPagar" />
                    <input class="form-control" readonly value="@(Model.Actual!.TotalPagar?.ToString("N2"))" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Dirección de envío</label>
                    <input asp-for="@Model.Actual!.DireccionEnvio" class="form-control" maxlength="200" />
                </div>
            </div>
            <div class="card-footer">
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" />
                <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
            </div>
        </div>
    }

    @if (Model.Borrar)
    {
        <div class="alert alert-warning mt-3">
            ¿Quiere borrar <b>@Model.Actual</b>?
            <input type="submit" value="Borrar" class="btn btn-danger btn-sm ms-2" asp-page-handler="BtBorrar" />
            <input type="submit" value="Cancelar" class="btn btn-secondary btn-sm" asp-page-handler="BtConsultar" />
        </div>
    }

    @if (!Model.Formulario)
    {
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                    <th>Id</th>
                    <th>Cliente</th>
                    <th>Sucursal</th>
                    <th>Promoción</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Total a pagar</th>
                    <th>Dirección de envío</th>
                    <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                        <td>@elemento.Id</td>
                        <td>@elemento._Cliente</td>
                        <td>@elemento._Sucursal</td>
                        <td>@elemento._Promocion</td>
                        <td>@elemento.FechaVenta?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@elemento.EstadoVenta</td>
                        <td>@elemento.TotalPagar?.ToString("N2")</td>
                        <td>@elemento.DireccionEnvio</td>
                        <td>
                            <a class="btn btn-outline-primary btn-sm" asp-page="/Ventanas/Factura" asp-route-id="@elemento.Id" target="_blank">Factura</a>
                            <input type="submit" value="Editar" class="btn btn-secondary btn-sm" asp-page-handler="BtEditar" asp-route-data="@elemento.Id" />
                            <input type="submit" value="Borrar" class="btn btn-danger btn-sm" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id" />
                        </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</form>
