@page
@model SucursalesModel
@{
    ViewData["Title"] = Model.Titulo;
}
<form method="post" enctype="multipart/form-data">
    <h1 class="text-center">Sucursales</h1>

    <div class="d-flex flex-wrap gap-2 justify-content-center my-3">
        <input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
        <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" />
        <input asp-for="@Model.Filtro!.NombreSucursal" class="form-control w-auto" placeholder="Buscar" />
        <input type="submit" value="PDF" class="btn btn-outline-secondary" asp-page-handler="BtPdf" />
        <input type="submit" value="Excel" class="btn btn-outline-secondary" asp-page-handler="BtExcel" />
    </div>

    @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml")

    @if (Model.Formulario || Model.Borrar)
    {
        <input type="hidden" asp-for="@Model.Actual!.Id" />
    }

    @if (Model.Formulario)
    {
        <div class="card mt-3">
            <div class="card-header">@(Model.Actual!.Id == 0 ? "Nuevo registro" : "Editar registro " + Model.Actual!.Id)</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre *</label>
                    <input asp-for="@Model.Actual!.NombreSucursal" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Dirección *</label>
                    <input asp-for="@Model.Actual!.Direccion" class="form-control" maxlength="200" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ciudad *</label>
                    <input asp-for="@Model.Actual!.Ciudad" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Teléfono</label>
                    <input asp-for="@Model.Actual!.TelefonoContacto" class="form-control" maxlength="20" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Horario de atención *</label>
                    <input asp-for="@Model.Actual!.HorarioAtencion" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Latitud</label>
                    <input type="number" step="any" asp-for="@Model.Actual!.Latitud" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Longitud</label>
                    <input type="number" step="any" asp-for="@Model.Actual!.Longitud" class="form-control" />
                </div>
            </div>
            <div class="card-footer">
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" />
                <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar" />
            </div>
        </div>
    }

    @if (Model.Borrar)
    {
        <div class="alert alert-warning mt-3">
            ¿Quiere borrar <b>@Model.Actual</b>?
            <input type="submit" value="Borrar" class="btn btn-danger btn-sm ms-2" asp-page-handler="BtBorrar" />
            <input type="submit" value="Cancelar" class="btn btn-secondary btn-sm" asp-page-handler="BtConsultar" />
        </div>
    }

    @if (!Model.Formulario)
    {
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>Ciudad</th>
                    <th>Teléfono</th>
                    <th>Horario de atención</th>
                    <th>Latitud</th>
                    <th>Longitud</th>
                    <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                        <td>@elemento.Id</td>
                        <td>@elemento.NombreSucursal</td>
                        <td>@elemento.Direccion</td>
                        <td>@elemento.Ciudad</td>
                        <td>@elemento.TelefonoContacto</td>
                        <td>@elemento.HorarioAtencion</td>
                        <td>@elemento.Latitud</td>
                        <td>@elemento.Longitud</td>
                        <td>
                            <input type="submit" value="Editar" class="btn btn-secondary btn-sm" asp-page-handler="BtEditar" asp-route-data="@elemento.Id" />
                            <input type="submit" value="Borrar" class="btn btn-danger btn-sm" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id" />
                        </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</form>
